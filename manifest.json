{
  "manifest_version": 3,
  "name": "대상 탭 자동 클릭 - 예약 확인 및 자동 열기",
  "short_name": "탭 자동 클릭",
  "description": "URL별 5시간 기본 확인 주기, 닫힌 탭 자동 열기, 반복 확인과 자동 클릭 기록을 지원합니다.",
  "version": "4.0.0",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webNavigation",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "대상 탭 자동 클릭 설정",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
